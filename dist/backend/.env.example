# ============================================================
# go图床 环境变量模板
# 用法：复制本文件为 .env，然后修改下面标注「必须修改」的项。
#       .env 已列入 .gitignore，不会被提交。
# ============================================================

# ---------- 必改 ----------
# 渠道密钥加密主密钥（AES-256-GCM）。至少 32 位随机字符。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 注意：部署后修改此项，已保存的渠道密钥将无法解密，需要重新填写。
CONFIG_SECRET=please-change-me-to-a-random-32-plus-char-string

# 初始管理员账户：首次启动直接写入数据库 users 表（幂等）。
#   不配置 → 用默认 admin / go-imgbed；库里已有管理员时不会被覆盖。
ADMIN_USER=admin
# ★ 必须改：这个是默认值，直接带到生产环境等于把后台敞开。
#   建议 12 位以上，混合大小写 + 数字 + 符号。
ADMIN_PASSWORD=change-me-before-first-run

# ---------- 可选 ----------
# 服务端口（容器内固定 3618，一般不需要改）
PORT=3618

# 超级管理员：用于找回管理员密码，默认关闭
# SUPER_ADMIN_USERNAME=
# SUPER_ADMIN_PASSWORD=

# 上传/接口授权码（留空表示不启用）
# AUTH_CODE=
# AUTH_MIKF=

# 限流开关（true/false，默认 true）
# RL_ENABLED=true

# 时区（Docker 部署建议 Asia/Shanghai）
TZ=Asia/Shanghai

# ---------- 本地运行 ----------
# v2.0.0 起只支持 PostgreSQL：DATABASE_URL 必须为 PG 连接串（本地直跑也要连库）。
# Docker 部署不要用这份模板，请用 docker/.env.example。
DATABASE_URL="postgresql://用户:密码@127.0.0.1:5432/go-imgbed?schema=public"
