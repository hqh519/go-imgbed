// ============================================================
//  go-imgbed v2.0.0 数据模型 —— PostgreSQL 版（唯一版本）
//
//  v2.0.0 起数据库只支持 PostgreSQL（推荐 pgvector/pgvector:pg17 及以上任意 PG 15+），
//  SQLite 双轨（schema.postgres.prisma）已随旧版终结删除，旧库不兼容、不做迁移。
//
//  设计约定：
//   1) 每张表都带 metas 字段（JSON 字符串），用于扩展数据；
//      但凡需要查询/筛选/排序的字段必须独立成列，禁止塞进 metas。
//      （保持 String 而非 Prisma Json：应用层全部按 JSON.parse/parse(stringify) 契约读写，
//        换 Json 类型需重写全部读写点，收益仅是 JSONB 运算符 —— 列为后续可选演进。）
//   2) 主键统一 cuid()（25 位字符串，见下方说明），不用自增整数。
//   3) 索引按真实查询路径规划（v2.0.0 重新规划）：
//        - 管理列表 / 目录浏览：status + folder/createdAt 复合
//        - 用户 / IP 归集：status + uploader 复合、ip 单列
//        - 去重（秒传）：md5 单列
//        - 渠道容量统计：channelId + status 复合
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// 关于主键 cuid（用户常见疑问）：
//   cuid 是 Prisma 默认的分布式友好 ID：25 位小写字母数字串（如 cmvbo02b5000kmuei41gf0ebe），
//   由「时间戳(毫秒) + 计数器 + 机器指纹 + 随机数」编码而成，全局唯一、按时间粗有序。
//   不改自增整数的原因：
//     a) 对外暴露自增 id 会泄露「系统一共处理过多少文件/用户」等信息；
//     b) 多实例 / 主备写入（file_copies 异步双写）下自增需要额外协调，cuid 天然无冲突；
//     c) 全站 URL、回收站批量操作、S3 接口都以字符串 id 为契约，改数字需重写全部接口。
//   对图床场景（万级~百万级记录）字符串主键的索引性能完全够用。
// ------------------------------------------------------------

// 用户账户 —— 管理员(admin) 与 普通用户(user)。
// 普通用户：仅可上传（需「用户名 + 上传密码」）与查看/管理自身账户下的文件（需「用户名 + 用户密码」），
// 且是否可编辑/删除自身文件、是否禁用由管理员逐个账户控制。
model User {
  id              String   @id @default(cuid())
  username        String   @unique
  passwordHash    String // 用户密码（登录文件管理页用）scrypt 格式 salt:hash
  uploadPassword  String   @default("") // 上传密码（前端上传页校验用），空则与 passwordHash 相同
  nickname        String   @default("") // 展示名
  role            String   @default("admin") // admin | user
  enabled         Boolean  @default(true) // 禁用后无法登录/上传
  canEdit         Boolean  @default(true) // 允许编辑自身文件（重命名/元数据/标签）
  canDelete       Boolean  @default(true) // 允许删除自身文件
  linkEnabled     Boolean  @default(true) // 链接权限：关闭后该账户的文件外链（/file/*）不可访问
  // 管理备注（v2.1.0）：仅管理员在「用户管理 → 编辑账户」里可见可改，绝不下发给普通用户
  adminNote       String   @default("")
  enforceLimits   Boolean  @default(true) // 类型和大小限制：开启时受「允许上传格式 + 单文件大小上限」约束，关闭则跳过
  mainChannelId   String   @default("") // 该账户上传时优先使用的主渠道 ID（空 = 用全局）
  backupChannelId String   @default("") // 该账户上传时优先使用的备份渠道 ID（空 = 用全局）
  metas           String   @default("{}")
  createdAt       DateTime @default(now())

  @@map("users")
}

// 系统设置（键值对；安全设置/页面设置/上传设置等各 section 各占一行）
model Setting {
  key   String @id
  value String @default("") // 值；JSON 类型的设置存 JSON 字符串
  metas String @default("{}")

  @@map("settings")
}

// 存储渠道配置（密钥字段 AES-GCM 加密后存于 config 内）
model Channel {
  id        String   @id @default(cuid())
  // 渠道业务 ID：6 位数字，创建后固定不变；
  // 系统内部（默认渠道 / 备份渠道 / 上传指定渠道）一律以 code 识别，渠道名可随意改但不允许重名。
  code      String   @unique
  name      String   @unique // 渠道显示名（可修改，不允许重名）
  type      String // cos | minio | r2 | s3 | easyimages | lsky | webdav | immich | custom | local
  enabled   Boolean  @default(true)
  isMain    Boolean  @default(false) // 主渠道（可多条，上传走 enable 的第一条主渠道）
  isBackup  Boolean  @default(false) // 备份渠道
  config    String   @default("{}") // JSON：各渠道配置，敏感字段加密存储
  // 渠道类型编号（排序用，与渠道 code 无关）：
  //   easyimages 100 / lsky 110 / immich 120 / minio 130 / r2 140 / s3 150
  //   cos 160 / aliyun 170 / webdav 180 / custom 190 / local 999
  // 所有渠道下拉框的排序规则（v2.0.0 起）：typeCode 升序 → name a→z
  typeCode  Int      @default(0)
  sortOrder Int      @default(0)
  metas     String   @default("{}")
  createdAt DateTime @default(now())

  copies FileCopy[]

  @@index([type, enabled])
  @@map("channels")
}

// 文件记录（对外文件标识 name 即外链 /file/:name 的 :name，随机生成、与主键 id 相互独立）
model FileRecord {
  id           String    @id @default(cuid())
  name         String    @unique
  originalName String
  size         Int       @default(0) // 字节；单文件上限受上传设置约束（默认远小于 2GB，Int 足够）
  originalSize Int       @default(0) // 压缩前的初始文件大小（字节）；未压缩时与 size 相同
  mime         String    @default("")
  hash         String    @default("") // sha256，用于秒传/去重
  md5          String    @default("") // md5，用于去重（配合 size）与搜索
  folder       String    @default("") // 逻辑分类目录（可后台移动，仅改库不改真实路径）
  uploader     String    @default("") // 上传者用户名（用户账户体系：文件按此归集给用户）
  // 上传渠道（上传来源入口）：
  //   Default  —— go-imgbed 前端上传页
  //   WebDAV   —— 对外 WebDAV
  //   API-Web  —— API Token 的「Web 通用」通道
  //   API-S3   —— API Token 的「S3 协议」通道
  uploadSource String    @default("Default")
  ip           String    @default("") // 上传来源 IP
  // 重定向地址：非空时 /file/:name 直接 302 到该地址（在不改图床外链的前提下替换真实文件源）；
  // 清空后自动恢复使用渠道真实直链。
  redirectUrl  String    @default("")
  // 限时访问（v2.1.0）：非空时 /file/:name 只在该时刻之前可用，过期返回 410 Gone；
  // 为空 = 永久有效（默认）。由文件详情页「限时」按钮设置/取消。
  linkExpiresAt DateTime?
  // 文件备注（v2.1.0）：仅上传者本人（作者）可见，管理端列表不下发；
  // 与 metas 分开存，避免被通用的 metas 覆盖写回逻辑抹掉。
  note         String    @default("")
  views        Int       @default(0) // 被访问次数（GET /file/:name 命中累计，管理端预览不计）
  status       String    @default("active") // active | deleted（deleted = 在回收站，可恢复）
  deletedAt    DateTime? // 进入回收站的时间；恢复时清空。排序/定期清理依据
  // 上传计时（后台文件详情 →「上传时长 / 上传速度」）：
  //   uploadStartedAt  请求到达服务端的时刻（分块上传为第一片 init 的时刻）
  //   uploadFinishedAt 文件记录落库的时刻
  uploadStartedAt  DateTime?
  uploadFinishedAt DateTime?
  metas        String    @default("{}") // 标签、备注等扩展
  createdAt    DateTime  @default(now())

  copies FileCopy[]
  tags   FileTag[]

  @@index([status, folder, createdAt]) // 目录浏览：过滤回收站 + 目录 + 时间排序
  @@index([status, createdAt]) // 全库文件列表 / 回收站列表
  @@index([status, uploader]) // 用户归集统计
  @@index([ip]) // IP 归集统计 / 黑白名单关联
  @@index([md5]) // 秒传去重
  @@map("files")
}

// 文件在各渠道的副本（主备双写的核心表）
model FileCopy {
  id        String   @id @default(cuid())
  fileId    String
  channelId String
  remoteKey String // 渠道内资源标识（只存 key，不存 URL —— 直链按渠道当前配置动态构造）
  remoteUrl String   @default("") // 仅 custom 渠道无法剥离域名时存完整 URL（访问时做域名替换）
  status    String   @default("active") // active | pending | failed
  isPrimary Boolean  @default(false) // 是否主渠道副本
  metas     String   @default("{}")
  createdAt DateTime @default(now())

  file    FileRecord @relation(fields: [fileId], references: [id], onDelete: Cascade)
  channel Channel    @relation(fields: [channelId], references: [id])

  @@unique([fileId, channelId])
  @@index([channelId, status]) // 渠道容量统计：按渠道聚合 active 副本
  @@map("file_copies")
}

// API Token（供自身系统 API 认证使用）
//   type = 's3'  —— S3 协议专用：配套 Access Key / Secret Key 等，可被外部 S3 客户端直接上传
//   type = 'web' —— 自定义 Web 通道专用：外部用 multipart POST 上传
// API Token 上传的文件统一归属管理员账户（或 Token 指定的归属账户）。
model ApiToken {
  id            String    @id @default(cuid())
  name          String
  type          String    @default("web") // web | s3
  tokenHash     String    @unique // sha256(token)
  prefix        String    @default("") // 展示用前缀，如 gb_xxxxxxxx
  permissions   String    @default("[]") // JSON 数组
  enabled       Boolean   @default(true)
  enforceLimits Boolean   @default(true) // 类型和大小限制：开启时该 Token 上传受「允许上传格式 + 单文件大小上限」约束，关闭则跳过
  lastUsedAt    DateTime?
  metas         String    @default("{}")
  createdAt     DateTime  @default(now())

  @@map("api_tokens")
}

// 标签
model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  metas     String   @default("{}")
  createdAt DateTime @default(now())

  files FileTag[]

  @@map("tags")
}

// 文件-标签关联
model FileTag {
  id        String     @id @default(cuid())
  fileId    String
  tagId     String
  file      FileRecord @relation(fields: [fileId], references: [id], onDelete: Cascade)
  tag       Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([fileId, tagId])
  @@index([tagId]) // 按标签找文件
  @@map("file_tags")
}

// IP 记录（用户管理 / IP 归属地）
model IpRecord {
  id          String   @id @default(cuid())
  ip          String   @unique
  country     String   @default("")
  region      String   @default("")
  city        String   @default("")
  uploadCount Int      @default(0)
  blocked     Boolean  @default(false)
  whitelisted Boolean  @default(false)
  metas       String   @default("{}")
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("ip_records")
}
